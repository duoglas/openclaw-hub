---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeQuickstartCTA from '../../components/HomeQuickstartCTA.astro';
import HomeCreatorCTA from '../../components/HomeCreatorCTA.astro';
import LatestDailySpotlight from '../../components/LatestDailySpotlight.astro';
import HomeHero from '../../components/HomeHero.astro';
import FeaturedGuides from '../../components/FeaturedGuides.astro';
import RecentAnalysis from '../../components/RecentAnalysis.astro';
import { getCollection } from 'astro:content';
import { isDailySlug } from '../../utils/contentSeries';

const posts = (await getCollection('blog'))
  .filter(p => p.data.lang === 'zh')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestDaily = posts.find(post => isDailySlug(post.id));
const latestDailySlug = latestDaily?.id.replace(/^zh\//, '').replace(/\.md$/, '');
---
<BaseLayout title="OpenClaw 部署排障与 AI 智能体资讯" description="查找 OpenClaw 部署与排障指南，处理 Telegram 冲突和 AI 编程工具问题，阅读附来源与日期的 AI 新闻简报。本站提供中英双语教程与实用工具说明。" lang="zh">
  <h1>🤖 AI 智能体资讯站</h1>
  <p style="font-size:1.1rem; margin:1rem 0;">聚焦 AI 智能体相关资讯、实操教程与工具指南。当前会有较多 OpenClaw 内容，但不局限于 OpenClaw。</p>

  <HomeHero alt="OpenClaw Hub 手绘介绍图" />
  <FeaturedGuides lang="zh" />
  <RecentAnalysis lang="zh" />
  
  <HomeCreatorCTA lang="zh" />
  <HomeQuickstartCTA lang="zh" />
  {latestDaily && latestDailySlug && (
    <LatestDailySpotlight
      lang="zh"
      title={latestDaily.data.title}
      description={latestDaily.data.description}
      href={`/zh/blog/${latestDailySlug}/`}
      dateLabel={latestDaily.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}
      rssHref="/zh/daily/rss.xml"
    />
  )}
<p style="margin:0 0 1rem;"><a href="/zh/daily/">📰 只看科技日报（连续阅读）</a> · <a href="/zh/daily/rss.xml">📡 RSS 订阅</a> · <a href="/coding/">⚡ Team Vibe Coding 子站</a></p>
  <h2>最新文章</h2>
  {posts.slice(0, 20).map(post => {
    const slug = post.id.replace(/^zh\//, '').replace(/\.md$/, '');
    const visibleTags = post.data.tags.slice(0, 3);
    const hiddenTagCount = Math.max(post.data.tags.length - visibleTags.length, 0);
    return (
      <a href={`/zh/blog/${slug}/`} style="text-decoration:none; color:inherit;">
        <div class="card" style="cursor:pointer;">
          <h3 style="margin-top:0;">{post.data.title}</h3>
          <p style="color:#999; margin:0.3rem 0;">{post.data.description}</p>
          <div style="color:#666; font-size:0.85rem;">
            {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}
            {' · '}
            {visibleTags.length > 0 && <span style="display:inline-flex;gap:4px;margin-top:4px;vertical-align:middle;">{visibleTags.map(tag => <span class="tag">{tag}</span>)}{hiddenTagCount > 0 && <span class="tag tag--more">+{hiddenTagCount}</span>}</span>}
          </div>
        </div>
      </a>
    );
  })}
</BaseLayout>
