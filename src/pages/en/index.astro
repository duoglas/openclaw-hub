---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeQuickstartCTA from '../../components/HomeQuickstartCTA.astro';
import HomeCreatorCTA from '../../components/HomeCreatorCTA.astro';
import LatestDailySpotlight from '../../components/LatestDailySpotlight.astro';
import HomeHero from '../../components/HomeHero.astro';
import FeaturedGuides from '../../components/FeaturedGuides.astro';
import RecentAnalysis from '../../components/RecentAnalysis.astro';
import { getCollection } from 'astro:content';
import { isDailySlug } from '../../utils/contentSeries';

const posts = (await getCollection('blog'))
  .filter(p => p.data.lang === 'en')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestDaily = posts.find(post => isDailySlug(post.id));
const latestDailySlug = latestDaily?.id.replace(/^en\//, '').replace(/\.md$/, '');
---
<BaseLayout title="OpenClaw Guides, Troubleshooting & AI Agent News" description="Deploy and troubleshoot OpenClaw, fix Telegram and coding-tool issues, and follow AI agent news. Practical guides with source links, dates, and bilingual coverage." lang="en">
  <h1>🤖 AI Agent Hub</h1>
  <p style="font-size:1.1rem; margin:1rem 0;">AI agent news, practical tutorials, and tooling guides. We cover OpenClaw deeply, but also track the broader agent ecosystem.</p>

  <HomeHero alt="OpenClaw Hub hand-drawn infographic" />
  <FeaturedGuides lang="en" />
  <RecentAnalysis lang="en" />
  
  <HomeCreatorCTA lang="en" />
  <HomeQuickstartCTA lang="en" />
  {latestDaily && latestDailySlug && (
    <LatestDailySpotlight
      lang="en"
      title={latestDaily.data.title}
      description={latestDaily.data.description}
      href={`/en/blog/${latestDailySlug}/`}
      dateLabel={latestDaily.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
      rssHref="/en/daily/rss.xml"
    />
  )}
<p style="margin:0 0 1rem;"><a href="/en/daily/">📰 Daily Briefs Only (continuous)</a> · <a href="/en/daily/rss.xml">📡 RSS feed</a></p>
  <h2>Latest Articles</h2>
  {posts.slice(0, 20).map(post => {
    const slug = post.id.replace(/^en\//, '').replace(/\.md$/, '');
    const visibleTags = post.data.tags.slice(0, 3);
    const hiddenTagCount = Math.max(post.data.tags.length - visibleTags.length, 0);
    return (
      <a href={`/en/blog/${slug}/`} style="text-decoration:none; color:inherit;">
        <div class="card" style="cursor:pointer;">
          <h3 style="margin-top:0;">{post.data.title}</h3>
          <p style="color:#999; margin:0.3rem 0;">{post.data.description}</p>
          <div style="color:#666; font-size:0.85rem;">
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            {' · '}
            {visibleTags.length > 0 && <span style="display:inline-flex;gap:4px;margin-top:4px;vertical-align:middle;">{visibleTags.map(tag => <span class="tag">{tag}</span>)}{hiddenTagCount > 0 && <span class="tag tag--more">+{hiddenTagCount}</span>}</span>}
          </div>
        </div>
      </a>
    );
  })}
</BaseLayout>
