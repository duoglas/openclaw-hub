---
import AdSenseHead from '../components/AdSenseHead.astro';
import HomeHero from '../components/HomeHero.astro';
import SiteLinks from '../components/SiteLinks.astro';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><AdSenseHead />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kuoo | AI Tools, Agent Harnesses &amp; Local Models</title>
  <meta name="description" content="Choose AI tools, understand agent harnesses and deploy local models. Source-based guides on workflows, permissions and verification, in English and Chinese." />
  <link rel="canonical" href="https://kuoo.uk/" />
  <link rel="alternate" hreflang="en" href="https://kuoo.uk/en/" /><link rel="alternate" hreflang="zh" href="https://kuoo.uk/zh/" /><link rel="alternate" hreflang="x-default" href="https://kuoo.uk/" />
  <meta property="og:title" content="Kuoo — AI Tools &amp; Model Guides" /><meta property="og:image" content="https://kuoo.uk/images/kuoo-social.png" />
  <style>
    * { box-sizing:border-box; } body { margin:0; background:#f6f8fb; color:#193042; font:16px/1.75 system-ui,sans-serif; }
    main { max-width:1080px; margin:0 auto; padding:45px 24px; } .brand { font-size:1.55rem; font-weight:800; color:#203448; margin-bottom:36px; }
    .languages { display:flex; flex-wrap:wrap; gap:14px; margin-bottom:28px; } .languages a { padding:10px 20px; border:1px solid #cfd9e4; border-radius:8px; text-decoration:none; color:#4338ca; font-weight:650; background:white; }
    .languages a:first-child { background:#4338ca; color:white; } .intro-zh { color:#526574; max-width:65ch; }
    footer { max-width:1080px; margin:0 auto; padding:0 24px 30px; }
  </style>
</head>
<body><main><div class="brand">Kuoo</div><div class="languages"><a href="/en/">Explore in English</a><a href="/zh/">进入中文站点</a></div><HomeHero lang="en" /><p class="intro-zh" lang="zh">AI 工具与模型的选择、接入和验证。了解 Harness，配置本地模型，检查自动化流程；写清方法、成本与适用条件。</p></main><footer><SiteLinks lang="en" /><SiteLinks lang="zh" /></footer></body>
</html>
